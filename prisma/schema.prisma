// Prisma schema — Inventory Management System
// Covers: Product Mgmt, Stock/Warehouse, Purchasing, Sales, POS,
// Reporting (derived from data below), Forecasting (derived), Roles, Notifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 2.8 Users, Roles & Permissions
// ---------------------------------------------------------------------------

enum RoleName {
  ADMIN
  MANAGER
  WAREHOUSE_STAFF
  SALES
  ACCOUNTANT
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          RoleName  @default(VIEWER)
  warehouseId   String?   // restrict staff to one warehouse; null = all
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs         AuditLog[]
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]
  stockMovements    StockMovement[]
  notifications     Notification[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "PRODUCT_UPDATED", "STOCK_ADJUSTED"
  entityType String   // e.g. "Product", "PurchaseOrder"
  entityId   String
  metadata   Json?    // before/after diff
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// 2.2 Warehouses / Locations
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users            User[]
  stockLevels      StockLevel[]
  stockMovementsIn StockMovement[] @relation("MovementToWarehouse")
  stockMovementsOut StockMovement[] @relation("MovementFromWarehouse")
  purchaseOrders   PurchaseOrder[]
  salesOrders      SalesOrder[]
}

// ---------------------------------------------------------------------------
// 2.1 Product / SKU Management
// ---------------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String
  parentId String?
  parent   Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  barcode       String?  @unique
  name          String
  description   String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  unit          String   // pcs, kg, litre, box...
  costPrice     Decimal  @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)
  reorderPoint  Int      @default(0)
  reorderQty    Int      @default(0)
  trackBatches  Boolean  @default(false) // enable batch/expiry/serial tracking
  isBundle      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images            ProductImage[]
  variants          ProductVariant[]
  batches           Batch[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems   SalesOrderItem[]
  bundleItems       ProductBundleItem[] @relation("BundleParent")
  partOfBundles     ProductBundleItem[] @relation("BundleComponent")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String  @unique
  attributes Json    // e.g. { "size": "L", "color": "Red" }
}

model ProductBundleItem {
  id           String  @id @default(cuid())
  bundleId     String
  bundle       Product @relation("BundleParent", fields: [bundleId], references: [id])
  componentId  String
  component    Product @relation("BundleComponent", fields: [componentId], references: [id])
  quantity     Int
}

// Batch/Lot + expiry + serial number tracking
model Batch {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  batchNumber  String
  serialNumber String?
  expiryDate   DateTime?
  quantity     Int
  warehouseId  String
  createdAt    DateTime  @default(now())

  @@index([productId, expiryDate])
}

// ---------------------------------------------------------------------------
// 2.2 Stock Levels & Movements
// ---------------------------------------------------------------------------

model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  binLocation String?
  quantity    Int       @default(0)
  reservedQty Int       @default(0) // reserved against pending sales orders

  @@unique([productId, warehouseId])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

model StockMovement {
  id              String            @id @default(cuid())
  type            StockMovementType
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  quantity        Int               // positive = in, negative = out
  fromWarehouseId String?
  fromWarehouse   Warehouse?        @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?        @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])
  reasonCode      String?           // e.g. "DAMAGE", "THEFT", "COUNT_CORRECTION"
  referenceType   String?           // "PurchaseOrder" | "SalesOrder" | "Transfer"
  referenceId     String?
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([productId, createdAt])
}

// ---------------------------------------------------------------------------
// 2.3 Purchasing
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  leadTimeDays Int?
  isActive  Boolean  @default(true)

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  expectedDate DateTime?
  rejectionReason String?
  createdAt   DateTime            @default(now())

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  orderedQty      Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
}

// ---------------------------------------------------------------------------
// 2.4 Sales & Orders
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  creditLimit Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  salesOrders SalesOrder[]
}

enum SalesOrderStatus {
  QUOTATION
  CONFIRMED
  PARTIALLY_SHIPPED
  SHIPPED
  INVOICED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(cuid())
  soNumber    String           @unique
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  status      SalesOrderStatus @default(QUOTATION)
  channel     String           @default("POS") // POS | ONLINE | MANUAL
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  items SalesOrderItem[]
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  discount     Decimal    @default(0) @db.Decimal(12, 2)
}

// ---------------------------------------------------------------------------
// 2.9 Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  LOW_STOCK
  EXPIRY_WARNING
  PO_APPROVAL_PENDING
  STOCK_TRANSFER_REQUEST
  GENERAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}
