# ==============================================================================
# Inventory Management System — Development Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT INFRASTRUCTURE (PHASE 1B — REQUIRED NOW)
# ------------------------------------------------------------------------------

# --- PostgreSQL 16+ ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory_dev
# Host port mapping for PostgreSQL (change to 5436 or 54320 if host 5432 is occupied)
POSTGRES_PORT=5432

# Canonical Database Connection URLs:
# A) When connecting from host machine (Node/NestJS running locally):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_dev?schema=public
# B) When connecting from inside Docker network (container-to-container):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/inventory_dev?schema=public

# --- Redis 7+ ---
# Host port mapping for Redis (change to 6380 or 63790 if host 6379 is occupied)
REDIS_PORT=6379

# Canonical Redis Connection URLs:
# A) When connecting from host machine:
REDIS_URL=redis://localhost:6379
# B) When connecting from inside Docker network:
# REDIS_URL=redis://redis:6379

# --- MinIO (S3-compatible Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=inventory-assets
S3_REGION=us-east-1

# Canonical S3 Endpoints:
# A) When connecting from host machine:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# B) When connecting from inside Docker network:
# S3_ENDPOINT=http://minio:9000

# ------------------------------------------------------------------------------
# 2. RUNTIME CONFIGURATION (PHASE 1C / 1D — REQUIRED IN SUBSEQUENT PHASES)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000
# Comma-separated list of allowed CORS origins:
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (PHASE 1E — REQUIRED IN SUBSEQUENT PHASES)
# ------------------------------------------------------------------------------
# Minimum 32-character secret key for JWT/session token signing.
AUTH_SECRET=development_auth_secret_must_be_changed_in_production_min_32_chars
