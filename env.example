# Database
DATABASE_URL="postgresql://ims_user:ims_password@localhost:5432/ims_db?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Redis (background jobs, caching)
REDIS_URL="redis://localhost:6379"

# Email (notifications)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# File storage (product images) — swap for S3/R2 in production
UPLOAD_DIR="./public/uploads"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION=""

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Feature flags (toggle modules as you build them phase by phase)
FEATURE_POS_ENABLED="false"
FEATURE_FORECASTING_ENABLED="false"
