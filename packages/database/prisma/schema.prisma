datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String                   @id @default(uuid())
  email           String                   @unique
  passwordHash    String
  isActive        Boolean                  @default(true)
  isPlatformAdmin Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  memberships               OrganizationMembership[]
  sessions                  Session[]
  createdStockLedgerEntries StockLedgerEntry[]
  createdPurchaseOrders     PurchaseOrder[]          @relation("PurchaseOrderCreator")
  approvedPurchaseOrders    PurchaseOrder[]          @relation("PurchaseOrderApprover")
  receivedGoodsReceipts     GoodsReceipt[]           @relation("GoodsReceiptReceiver")
  createdStockTransfers     StockTransfer[]          @relation("StockTransferCreator")
  approvedStockTransfers    StockTransfer[]          @relation("StockTransferApprover")
  shippedStockTransfers     StockTransfer[]          @relation("StockTransferShipper")
  receivedStockTransfers    StockTransfer[]          @relation("StockTransferReceiver")
  cancelledStockTransfers   StockTransfer[]          @relation("StockTransferCanceller")
  createdSalesOrders        SalesOrder[]             @relation("SalesOrderCreator")
  approvedSalesOrders       SalesOrder[]             @relation("SalesOrderApprover")
  fulfilledSalesOrders      SalesOrder[]             @relation("SalesOrderFulfiller")
  cancelledSalesOrders      SalesOrder[]             @relation("SalesOrderCanceller")
  notifications             Notification[]
  exportJobs                ExportJob[]
  importJobs                ImportJob[]
  handledAccountRequests    AccountRequest[]
}

model Organization {
  id                 String                   @id @default(uuid())
  slug               String                   @unique
  name               String
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memberships        OrganizationMembership[]
  auditEvents        AuditEvent[]
  categories         Category[]
  products           Product[]
  warehouses         Warehouse[]
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockTransfers     StockTransfer[]
  stockTransferLines StockTransferLine[]
  customers          Customer[]
  salesOrders        SalesOrder[]
  salesOrderLines    SalesOrderLine[]
  notifications      Notification[]
  exportJobs         ExportJob[]
  importJobs         ImportJob[]
}

model Role {
  id          String                   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  permissions RolePermission[]
  memberships OrganizationMembership[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id             String        @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  requestId      String?
  createdAt      DateTime      @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, createdAt])
}

enum UnitOfMeasure {
  UNIT
  KG
  G
  L
  ML
  M
  CM
  BOX
  PACK
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  categoryId     String
  name           String
  sku            String
  description    String?
  unitOfMeasure  UnitOfMeasure @default(UNIT)
  unitCost       Decimal?      @db.Decimal(14, 4)
  unitPrice      Decimal?      @db.Decimal(14, 4)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           Category           @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockTransferLines StockTransferLine[]
  salesOrderLines    SalesOrderLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, createdAt])
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id                 String             @id @default(uuid())
  organizationId     String
  name               String
  code               String
  description        String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  status             WarehouseStatus    @default(ACTIVE)
  isDefault          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  outgoingTransfers  StockTransfer[]    @relation("TransferSourceWarehouse")
  incomingTransfers  StockTransfer[]    @relation("TransferDestinationWarehouse")
  salesOrders        SalesOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

enum StockLedgerEntryType {
  OPENING
  RECEIPT
  ISSUE
  ADJUSTMENT
}

model StockBalance {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  quantity       Decimal      @default(0) @db.Decimal(14, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  warehouse      Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, productId, warehouseId])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
}

model StockLedgerEntry {
  id             String               @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  quantityDelta  Decimal              @db.Decimal(14, 4)
  quantityBefore Decimal              @db.Decimal(14, 4)
  quantityAfter  Decimal              @db.Decimal(14, 4)
  type           StockLedgerEntryType
  referenceType  String?
  referenceId    String?
  idempotencyKey String?
  createdById    String?
  metadata       Json?
  createdAt      DateTime             @default(now())

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  warehouse      Warehouse            @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  creator        User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, createdAt])
  @@index([organizationId, productId, warehouseId, createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                  String              @id @default(uuid())
  organizationId      String
  purchaseOrderNumber String
  idempotencyKey      String?
  idempotencyPayloadHash String?
  supplierName        String
  supplierEmail       String?
  status              PurchaseOrderStatus @default(DRAFT)
  orderDate           DateTime            @default(now())
  expectedDate        DateTime?
  warehouseId         String
  currency            String              @default("INR")
  subtotal            Decimal             @db.Decimal(14, 4)
  taxTotal            Decimal             @default(0) @db.Decimal(14, 4)
  grandTotal          Decimal             @db.Decimal(14, 4)
  notes               String?
  createdById         String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse           @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  creator      User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approver     User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines        PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseOrderNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId])
  @@index([organizationId, orderDate])
  @@index([organizationId, expectedDate])
  @@index([organizationId, createdAt])
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  organizationId   String
  purchaseOrderId  String
  productId        String
  quantity         Decimal       @db.Decimal(14, 4)
  unitPrice        Decimal       @db.Decimal(14, 4)
  lineTotal        Decimal       @db.Decimal(14, 4)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 4)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder      @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)
  product           Product            @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  goodsReceiptLines GoodsReceiptLine[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, productId])
  @@index([organizationId, createdAt])
}

model GoodsReceipt {
  id                     String             @id @default(uuid())
  organizationId         String
  purchaseOrderId        String
  warehouseId            String
  receiptNumber          String
  idempotencyKey         String?
  idempotencyPayloadHash String?
  notes                  String?
  receivedById           String?
  receivedAt             DateTime           @default(now())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)
  warehouse     Warehouse          @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  receiver      User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, receivedAt])
  @@index([organizationId, idempotencyKey])
}

model GoodsReceiptLine {
  id                  String        @id @default(uuid())
  organizationId      String
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  quantityReceived    Decimal       @db.Decimal(14, 4)
  createdAt           DateTime      @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt      @relation(fields: [organizationId, goodsReceiptId], references: [organizationId, id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict)
  product           Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, goodsReceiptId])
  @@index([organizationId, purchaseOrderLineId])
  @@index([organizationId, productId])
}

enum StockTransferStatus {
  DRAFT
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id                     String              @id @default(uuid())
  organizationId         String
  transferNumber         String
  idempotencyKey         String?
  idempotencyPayloadHash String?
  status                 StockTransferStatus @default(DRAFT)
  sourceWarehouseId      String
  destinationWarehouseId String
  notes                  String?
  createdById            String?
  approvedById           String?
  approvedAt             DateTime?
  shippedById            String?
  shippedAt              DateTime?
  receivedById           String?
  receivedAt             DateTime?
  cancelledById          String?
  cancelledAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceWarehouse      Warehouse           @relation("TransferSourceWarehouse", fields: [organizationId, sourceWarehouseId], references: [organizationId, id], onDelete: Restrict)
  destinationWarehouse Warehouse           @relation("TransferDestinationWarehouse", fields: [organizationId, destinationWarehouseId], references: [organizationId, id], onDelete: Restrict)
  creator              User?               @relation("StockTransferCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approver             User?               @relation("StockTransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  shipper              User?               @relation("StockTransferShipper", fields: [shippedById], references: [id], onDelete: SetNull)
  receiver             User?               @relation("StockTransferReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  canceller            User?               @relation("StockTransferCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines                StockTransferLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, transferNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, sourceWarehouseId])
  @@index([organizationId, destinationWarehouseId])
  @@index([organizationId, createdAt])
}

model StockTransferLine {
  id             String        @id @default(uuid())
  organizationId String
  transferId     String
  productId      String
  quantity       Decimal       @db.Decimal(14, 4)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transfer     StockTransfer @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Cascade)
  product      Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, transferId, productId])
  @@index([organizationId])
  @@index([organizationId, transferId])
  @@index([organizationId, productId])
  @@index([organizationId, createdAt])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrders    SalesOrder[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
}

enum SalesOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FULFILLED
  CANCELLED
}

model SalesOrder {
  id                     String           @id @default(uuid())
  organizationId         String
  salesOrderNumber       String
  idempotencyKey         String?
  idempotencyPayloadHash String?
  customerId             String?
  customerName           String
  customerEmail          String?
  status                 SalesOrderStatus @default(DRAFT)
  orderDate              DateTime         @default(now())
  expectedDate           DateTime?
  warehouseId            String
  currency               String           @default("INR")
  subtotal               Decimal          @db.Decimal(14, 4)
  taxTotal               Decimal          @default(0) @db.Decimal(14, 4)
  grandTotal             Decimal          @db.Decimal(14, 4)
  notes                  String?
  createdById            String?
  approvedById           String?
  approvedAt             DateTime?
  fulfilledById          String?
  fulfilledAt            DateTime?
  cancelledById          String?
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer?        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  creator      User?            @relation("SalesOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approver     User?            @relation("SalesOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  fulfiller    User?            @relation("SalesOrderFulfiller", fields: [fulfilledById], references: [id], onDelete: SetNull)
  canceller    User?            @relation("SalesOrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines        SalesOrderLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, salesOrderNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId])
  @@index([organizationId, customerId])
  @@index([organizationId, orderDate])
  @@index([organizationId, createdAt])
}

model SalesOrderLine {
  id             String     @id @default(uuid())
  organizationId String
  salesOrderId   String
  productId      String
  quantity       Decimal    @db.Decimal(14, 4)
  unitPrice      Decimal    @db.Decimal(14, 4)
  lineTotal      Decimal    @db.Decimal(14, 4)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder   @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: Cascade)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, productId])
  @@index([organizationId, createdAt])
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPORT_READY
  EXPORT_FAILED
  IMPORT_COMPLETED
  IMPORT_FAILED
  SYSTEM
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String?
  type           NotificationType @default(SYSTEM)
  title          String
  message        String
  metadata       Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, isRead])
  @@index([organizationId, userId, isRead])
  @@index([organizationId, createdAt])
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id             String          @id @default(uuid())
  organizationId String
  userId         String
  reportType     String
  status         ExportJobStatus @default(PENDING)
  queryParams    Json?
  fileName       String?
  fileSize       Int?
  rowCount       Int?
  errorMessage   String?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, userId])
  @@index([organizationId, createdAt])
}

enum ImportJobType {
  PRODUCT
  STOCK
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
}

model ImportJob {
  id             String          @id @default(uuid())
  organizationId String
  userId         String
  type           ImportJobType
  status         ImportJobStatus @default(PENDING)
  fileName       String
  fileSize       Int
  totalRows      Int             @default(0)
  processedRows  Int             @default(0)
  successfulRows Int             @default(0)
  failedRows     Int             @default(0)
  errors         Json?
  metadata       Json?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, userId])
  @@index([organizationId, createdAt])
}

enum AccountRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
  COMPLETED
}

model AccountRequest {
  id          String               @id @default(uuid())
  name        String
  phone       String
  email       String?
  status      AccountRequestStatus @default(PENDING)
  notes       String?
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  handledBy   User?                @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}
