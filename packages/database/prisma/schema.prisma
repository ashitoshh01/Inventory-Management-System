datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String                   @id @default(uuid())
  email        String                   @unique
  passwordHash String
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships               OrganizationMembership[]
  sessions                  Session[]
  createdStockLedgerEntries StockLedgerEntry[]
  createdPurchaseOrders     PurchaseOrder[]          @relation("PurchaseOrderCreator")
  approvedPurchaseOrders    PurchaseOrder[]          @relation("PurchaseOrderApprover")
  receivedGoodsReceipts     GoodsReceipt[]           @relation("GoodsReceiptReceiver")
}

model Organization {
  id                 String                   @id @default(uuid())
  slug               String                   @unique
  name               String
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memberships        OrganizationMembership[]
  auditEvents        AuditEvent[]
  categories         Category[]
  products           Product[]
  warehouses         Warehouse[]
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
}

model Role {
  id          String                   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  permissions RolePermission[]
  memberships OrganizationMembership[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id             String        @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  requestId      String?
  createdAt      DateTime      @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, createdAt])
}

enum UnitOfMeasure {
  UNIT
  KG
  G
  L
  ML
  M
  CM
  BOX
  PACK
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  categoryId     String
  name           String
  sku            String
  description    String?
  unitOfMeasure  UnitOfMeasure @default(UNIT)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           Category           @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, createdAt])
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id                 String             @id @default(uuid())
  organizationId     String
  name               String
  code               String
  description        String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  status             WarehouseStatus    @default(ACTIVE)
  isDefault          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

enum StockLedgerEntryType {
  OPENING
  RECEIPT
  ISSUE
  ADJUSTMENT
}

model StockBalance {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  quantity       Decimal      @default(0) @db.Decimal(14, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  warehouse      Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, productId, warehouseId])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
}

model StockLedgerEntry {
  id             String               @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  quantityDelta  Decimal              @db.Decimal(14, 4)
  quantityBefore Decimal              @db.Decimal(14, 4)
  quantityAfter  Decimal              @db.Decimal(14, 4)
  type           StockLedgerEntryType
  referenceType  String?
  referenceId    String?
  idempotencyKey String?
  createdById    String?
  metadata       Json?
  createdAt      DateTime             @default(now())

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  warehouse      Warehouse            @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  creator        User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, createdAt])
  @@index([organizationId, productId, warehouseId, createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                  String              @id @default(uuid())
  organizationId      String
  purchaseOrderNumber String
  idempotencyKey      String?
  idempotencyPayloadHash String?
  supplierName        String
  supplierEmail       String?
  status              PurchaseOrderStatus @default(DRAFT)
  orderDate           DateTime            @default(now())
  expectedDate        DateTime?
  warehouseId         String
  currency            String              @default("INR")
  subtotal            Decimal             @db.Decimal(14, 4)
  taxTotal            Decimal             @default(0) @db.Decimal(14, 4)
  grandTotal          Decimal             @db.Decimal(14, 4)
  notes               String?
  createdById         String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse           @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  creator      User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approver     User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines        PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseOrderNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId])
  @@index([organizationId, orderDate])
  @@index([organizationId, expectedDate])
  @@index([organizationId, createdAt])
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  organizationId   String
  purchaseOrderId  String
  productId        String
  quantity         Decimal       @db.Decimal(14, 4)
  unitPrice        Decimal       @db.Decimal(14, 4)
  lineTotal        Decimal       @db.Decimal(14, 4)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 4)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder      @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)
  product           Product            @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  goodsReceiptLines GoodsReceiptLine[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, productId])
  @@index([organizationId, createdAt])
}

model GoodsReceipt {
  id                     String             @id @default(uuid())
  organizationId         String
  purchaseOrderId        String
  warehouseId            String
  receiptNumber          String
  idempotencyKey         String?
  idempotencyPayloadHash String?
  notes                  String?
  receivedById           String?
  receivedAt             DateTime           @default(now())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)
  warehouse     Warehouse          @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  receiver      User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, receivedAt])
  @@index([organizationId, idempotencyKey])
}

model GoodsReceiptLine {
  id                  String        @id @default(uuid())
  organizationId      String
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  quantityReceived    Decimal       @db.Decimal(14, 4)
  createdAt           DateTime      @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt      @relation(fields: [organizationId, goodsReceiptId], references: [organizationId, id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict)
  product           Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, goodsReceiptId])
  @@index([organizationId, purchaseOrderLineId])
  @@index([organizationId, productId])
}

